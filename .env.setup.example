# 仅本机一次性初始化使用：复制为 .env.setup，绝不要提交或部署到前端
# service_role 可绕过 RLS，泄露等于数据库被接管
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 管理员登录账号与强密码（至少 8 位）
# 登录页可只输入 @ 前面的账号名，系统会补全为 <账号>@attendance.local
ADMIN_EMAIL=admin@attendance.local
ADMIN_PASSWORD=replace-with-a-strong-password

# seed 脚本也可复用上面的管理员凭据；有 service_role 时优先使用 service_role
